generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  FUNCIONARIO
  GESTOR
  COMPRAS
  ADMIN
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum EstadoSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
  SOLICITACAO_REENVIADA
  EM_COMPRA
  FINALIZADA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String
  departamento String
  perfil       Perfil   @default(FUNCIONARIO)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  solicitacoes Solicitacao[]
  historicos   HistoricoSolicitacao[]

  @@map("usuarios")
}

model Solicitacao {
  id            Int               @id @default(autoincrement())
  titulo        String
  descricao     String
  valorEstimado Decimal           @db.Decimal(10, 2) @map("valor_estimado")
  categoria     String
  departamento  String
  prioridade    Prioridade        @default(BAIXA)
  estado        EstadoSolicitacao @default(PENDENTE)
  
  solicitanteId Int               @map("solicitante_id")
  solicitante   Usuario           @relation(fields: [solicitanteId], references: [id])

  criadoEm     DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime           @updatedAt @map("atualizado_em")

  historico    HistoricoSolicitacao[]

  @@map("solicitacoes")
}

model HistoricoSolicitacao {
  id             Int                @id @default(autoincrement())
  solicitacaoId  Int                @map("solicitacao_id")
  solicitacao    Solicitacao        @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  
  usuarioId      Int?               @map("usuario_id")
  usuario        Usuario?           @relation(fields: [usuarioId], references: [id])

  estadoAnterior EstadoSolicitacao? @map("estado_anterior")
  novoEstado     EstadoSolicitacao  @map("novo_estado")
  observacao     String?
  dataHora       DateTime           @default(now()) @map("data_hora")

  @@map("historico_solicitacoes")
}